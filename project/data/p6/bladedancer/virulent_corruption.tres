[gd_resource type="Resource" script_class="Talent" format=3]
[ext_resource type="Script" path="res://scripts/resources/talent.gd" id="talent"]
[ext_resource type="Script" path="res://scripts/resources/talent_rank.gd" id="rank"]
[ext_resource type="Script" path="res://scripts/resources/stat_modifier.gd" id="modifier"]

[sub_resource type="Resource" id="main1"]
script = ExtResource("modifier")
stat_id = "shred_value"
value = 100.00000000

[sub_resource type="Resource" id="stacks1"]
script = ExtResource("modifier")
stat_id = "bonus_shred_stacks"
value = 2.00000000

[sub_resource type="Resource" id="rank1"]
script = ExtResource("rank")
stat_modifiers = Array[ExtResource("modifier")]([SubResource("main1"), SubResource("stacks1")])
shred_cleanse_immune = true

[resource]
script = ExtResource("talent")
id = "talent.bladedancer.virulent_corruption"
display_name = "Virulent Corruption"
max_ranks = 1
required_tree_points = 20
ranks = Array[ExtResource("rank")]([SubResource("rank1")])
