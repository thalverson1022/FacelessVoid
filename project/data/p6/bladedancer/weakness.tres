[resource]
script = ExtResource("talent")
id = "talent.bladedancer.weakness"
display_name = "Weakness"
max_ranks = 5
required_tree_points = 0
ranks = Array[ExtResource("rank")]([SubResource("rank1"), SubResource("rank2"), SubResource("rank3"), SubResource("rank4"), SubResource("rank5")])
