[gd_resource type="Resource" script_class="Talent" format=3]
[ext_resource type="Script" path="res://scripts/resources/talent.gd" id="talent"]
[ext_resource type="Script" path="res://scripts/resources/talent_rank.gd" id="rank"]
[ext_resource type="Script" path="res://scripts/resources/stat_derivation_rule.gd" id="rule"]

[sub_resource type="Resource" id="rule1"]
script = ExtResource("rule")
kind = "double_dip"
fraction = 0.50000000

[sub_resource type="Resource" id="rank1"]
script = ExtResource("rank")
stat_derivations = Array[Resource]([SubResource("rule1")])

[sub_resource type="Resource" id="rule2"]
script = ExtResource("rule")
kind = "double_dip"
fraction = 1.00000000

[sub_resource type="Resource" id="rank2"]
script = ExtResource("rank")
stat_derivations = Array[Resource]([SubResource("rule2")])

[resource]
script = ExtResource("talent")
id = "talent.bladedancer.double_dip"
display_name = "Double Dip"
max_ranks = 2
required_tree_points = 5
ranks = Array[ExtResource("rank")]([SubResource("rank1"), SubResource("rank2")])
