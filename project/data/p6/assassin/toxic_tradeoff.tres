[sub_resource type="Resource" id="mod5"]
script = ExtResource("modifier")
stat_id = "percent_physical_damage"
value = -0.50000000

[sub_resource type="Resource" id="rank5"]
script = ExtResource("rank")
stat_modifiers = Array[StatModifier]([SubResource("mod5")])
toxic_tradeoff_rank = 5

[resource]
script = ExtResource("talent")
id = "talent.assassin.toxic_tradeoff"
display_name = "Toxic Tradeoff"
max_ranks = 5
required_tree_points = 10
ranks = Array[ExtResource("rank")]([SubResource("rank1"), SubResource("rank2"), SubResource("rank3"), SubResource("rank4"), SubResource("rank5")])
